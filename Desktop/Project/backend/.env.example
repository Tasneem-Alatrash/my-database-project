# Anthropic API key used for waste image classification (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model used for classification
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the SQLite database location
# DATABASE_URL=sqlite:///./resort_ai.db

# Origin allowed to call this API (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
